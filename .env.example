# Copy to .env (chmod 600 on the VPS). Never commit .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=8790
DATA_DIR=./data
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# Set to true only behind nginx with TLS (cookie Secure flag, trust proxy)
BEHIND_TLS=true
# Generate with: npm run hash-password -- "your password"
OWNER_PASSWORD_HASH=
